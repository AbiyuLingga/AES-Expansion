# Original Terasic DE1 Cyclone II EP2C20F484C7 / official DE1 manual
# Scalar port assignments. PIN_M1 IS SW8, NOT CLOCK_50.
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name TOP_LEVEL_ENTITY aes_de1_fixed
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE aes_de1_fixed.sdc
set_global_assignment -name VHDL_FILE aes128_keyexp_pkg.vhd
set_global_assignment -name VHDL_FILE aes128_keyexp.vhd
set_global_assignment -name VHDL_FILE uart_tx_8n1.vhd
set_global_assignment -name VHDL_FILE uart_rx_8n1.vhd
set_global_assignment -name VHDL_FILE uart_key_parser.vhd
set_global_assignment -name VHDL_FILE aes_uart_dump.vhd
set_global_assignment -name VHDL_FILE aes_de1_fixed.vhd
set_location_assignment PIN_L1 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_location_assignment PIN_R22 -to KEY0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY0
set_location_assignment PIN_R21 -to KEY1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY1
set_location_assignment PIN_L22 -to SW0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW0
set_location_assignment PIN_L21 -to SW1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW1
set_location_assignment PIN_M22 -to SW2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW2
set_location_assignment PIN_V12 -to SW3
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW3
set_location_assignment PIN_W12 -to SW4
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW4
set_location_assignment PIN_U12 -to SW5
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW5
set_location_assignment PIN_U11 -to SW6
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW6
set_location_assignment PIN_M2 -to SW7
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW7
set_location_assignment PIN_U22 -to LEDG0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDG0
set_location_assignment PIN_U21 -to LEDG1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDG1
set_location_assignment PIN_V22 -to LEDG2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDG2
set_location_assignment PIN_V21 -to LEDG3
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDG3
set_location_assignment PIN_J2 -to HEX0_A
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0_A
set_location_assignment PIN_J1 -to HEX0_B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0_B
set_location_assignment PIN_H2 -to HEX0_C
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0_C
set_location_assignment PIN_H1 -to HEX0_D
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0_D
set_location_assignment PIN_F2 -to HEX0_E
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0_E
set_location_assignment PIN_F1 -to HEX0_F
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0_F
set_location_assignment PIN_E2 -to HEX0_G
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0_G
set_location_assignment PIN_E1 -to HEX1_A
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX1_A
set_location_assignment PIN_H6 -to HEX1_B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX1_B
set_location_assignment PIN_H5 -to HEX1_C
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX1_C
set_location_assignment PIN_H4 -to HEX1_D
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX1_D
set_location_assignment PIN_G3 -to HEX1_E
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX1_E
set_location_assignment PIN_D2 -to HEX1_F
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX1_F
set_location_assignment PIN_D1 -to HEX1_G
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX1_G
set_location_assignment PIN_G5 -to HEX2_A
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2_A
set_location_assignment PIN_G6 -to HEX2_B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2_B
set_location_assignment PIN_C2 -to HEX2_C
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2_C
set_location_assignment PIN_C1 -to HEX2_D
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2_D
set_location_assignment PIN_E3 -to HEX2_E
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2_E
set_location_assignment PIN_E4 -to HEX2_F
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2_F
set_location_assignment PIN_D3 -to HEX2_G
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2_G
set_location_assignment PIN_F4 -to HEX3_A
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_A
set_location_assignment PIN_D5 -to HEX3_B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_B
set_location_assignment PIN_D6 -to HEX3_C
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_C
set_location_assignment PIN_J4 -to HEX3_D
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_D
set_location_assignment PIN_L8 -to HEX3_E
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_E
set_location_assignment PIN_F3 -to HEX3_F
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_F
set_location_assignment PIN_D4 -to HEX3_G
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX3_G

# DE1 v1.x on-board MAX232, DB9 RS-232 (manual Table 4.10)
set_location_assignment PIN_G12 -to UART_TXD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TXD

# DE1 RS-232 RX, MAX232 built-in
set_location_assignment PIN_F14 -to UART_RXD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RXD

set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top